@startuml
title DIAGRAMA DE CLASES - Captura de datos

skinparam backgroundColor #FAFBFC
skinparam shadowing false
skinparam roundcorner 15
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #334155
    ArrowColor #475569
    FontColor #0F172A
    AttributeFontColor #334155
    MethodFontColor #334155
    HeaderFontColor #0F172A
}

class CaptureWindow <<QWidget>> {
    - controller_keyboard : ControllerKeyboardCapture
    - controller_save_capture : controllerSaveCapture
    - keyboard_window : KeyboardWindow
    '- black_screen : BlackScreen
    --
    + __init__(self, ControllerKeyboard=None, ControllerSaveCapture=None)
    + setup_ui(self)
    + update_character_options(self)
    + show_path(self)
    + load_users(self)
    + create_user(self)
    + start_capture(self)
    + start_n_times(self)
    '+ start_capture_n_times_after_rest(self)
    '+ show_grid_after_rest(self)
    '+ show_grid(self)
    '+ hide_grid(self)
    '+ isBlackScreenVisible(self)
    '+ closeEvent(self, event : QCloseEvent)
    + quit(self)
}

class controllerSaveCapture {
    - serial_monitor : SignalsWindow
    '- edf_full_path : str
    '- full_path : str
    - duration : int
    --
    + __init__(self, serial_monitor : SignalsWindow)
    + save_capture(self, callback=None)
    '+ clean_df_file(self, df)
    + save_capture_edf(self)
    + start_capture(self, user, character_type, character, duration, callback=None, online=False)
    '+ _on_recording_finished(self, callback=None)
    + start_capture_n_times(self, user, character_type, character, duration, times, controller_keyboard)
}

class ControllerKeyboardCapture {
    - keyboard_window : KeyboardWindow
    --
    + __init__(self, WindowKeyboard : KeyboardWindow)
    + flash_character(self, character, duration=0.5)
    + hide_grid(self)
}

class SignalsWindow <<QMainWindow>> {
    + start_recording(self, duration=2)
    + return_recorded_data(self)
}

class KeyboardWindow <<QWidget>> {
    + flash_button(self, button, duration=1.0, COLOR="#00FF00")
    + hide_grid(self)
    + show_grid_after_rest(self)
}

CaptureWindow ..> ControllerKeyboardCapture : captura / flash
CaptureWindow ..> controllerSaveCapture : almacenamiento
controllerSaveCapture --> SignalsWindow : EEG grabado
ControllerKeyboardCapture --> KeyboardWindow
'CaptureWindow --> KeyboardWindow
'CaptureWindow --> BlackScreen

legend bottom
|= Relacion |= Significado |
| --> | Utiliza |
| ..> | Interaccion vista-controlador |
endlegend
@enduml
