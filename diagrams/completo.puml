class SerialReader <<QThread>> {
    - port : str
    - baudrate : int
    - data_queue : Queue
    --
    + __init__(self, port, baudrate, data_queue, sixteen_mode)
    + printRegisters(self)
    + run(self)
    + stop(self)
}

class EmotivReader <<QThread>> {
    - data_queue : Queue
    - running : bool
    - cipher
    - decoder : EmotivPacketDecoder
    --
    + __init__(self, data_queue)
    + run(self)
    + stop(self)
}

class EmotivPacketDecoder {
    - sensors : dict
    - battery_raw
    - battery_percent
    --
    + __init__(self)
    + decode(self, raw_data)
}

class PlottingThread <<QThread>> {
    - data_buffer
    - buffer_lock
    - plots
    - filter : EEGFilter
    --
    + __init__(self, data_buffer, buffer_lock, plots, channels, apply_filter)
    + run(self)
    + stop(self)
    + set_apply_filter(self, apply_filter)
}

class RecordingThread <<QThread>> {
    - recording_queue : Queue
    - filter : EEGFilter
    - duration
    --
    + __init__(self)
    + start_recording(self, columns_df, duration)
    + stop_recording(self)
    + get_recorded_data(self)
    + get_filtered_recording_df(self)
    + run(self)
}

class EEGFilter {
    - fs : int[cite: 2, 6, 7]
    - use_notch : bool
    - use_bandpass : bool
    --
    + __init__(self, fs=250, low=0.5, high=40, notch_freq=60, use_bandpass=False, use_notch=True)
    + apply(self, signal)
}

class SerialConfiguration <<QWidget>> {
    - controller_serial_config : ControllerSerialConfig
    - port : QComboBox
    - baudrate : QLineEdit
    --
    + __init__(self, controller_serial_config : ControllerSerialConfig)
    + configure_serial(self)
    + get_port(self)
    + get_baudrate(self)
}

class ControllerSerialConfig {
    - signals_window : SignalsWindow
    --
    + __init__(self, signals_window)
    + update_serial_config(self, port, baudrate)
}

class KeyboardWindow <<QWidget>> {
    - training_mode : bool
    - buttons_list : list
    - output_line : OutputLine
    --
    + __init__(self, training_mode=False)
    + setup_ui(self)
    + button_clicked(self, button)
    + flash_button(self, button, duration=1.0, COLOR="#00FF00")[cite: 4, 5]
    + add_character(self, char)[cite: 4, 6]
    + start_paradigm(self, times=5)
    + show_grid(self)
    + closeEvent(self, event : QCloseEvent)
    + quit(self)
}

class OutputLine <<QWidget>> {
    - label : QLineEdit
    --
    + __init__(self, text)
    + set_text(self, text)
    + add_character(self, char)
}

class ControllerKeyboardCapture {
    - keyboard_window : KeyboardWindow[cite: 4, 5]
    - flash_idx : int
    - flash_list : list
    --
    + __init__(self, WindowKeyboard : KeyboardWindow)[cite: 4, 5]
    + flash_character(self, character, duration=0.5)[cite: 4, 5]
    + start_simulation(self)
    + _flash_step(self, flash_time)
    + hide_grid(self)[cite: 4, 5]
}

class CaptureWindow <<QWidget>> {
    - controller_keyboard : ControllerKeyboardCapture
    - controller_save_capture : controllerSaveCapture
