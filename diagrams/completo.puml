    --
    + __init__(self, ControllerKeyboard=None, ControllerSaveCapture=None)
    + setup_ui(self)
    + update_character_options(self)
    + show_path(self)
    + load_users(self)
    + create_user(self)
    + start_capture(self)
    + start_n_times(self)
    + quit(self)
}

class controllerSaveCapture {
    - serial_monitor : SignalsWindow[cite: 5, 6]
    - duration : int
    --
    + __init__(self, serial_monitor : SignalsWindow)
    + save_capture(self, callback=None)[cite: 5, 6]
    + save_capture_edf(self)
    + start_capture(self, user, character_type, character, duration, callback=None, online=False)[cite: 5, 6]
    + start_capture_n_times(self, user, character_type, character, duration, times, controller_keyboard)
}

class SpellerConfigurationWindow <<QWidget>> {
    - predict_controller : PredictorController
    - save_capture_controller : controllerSaveCapture
    - keyboard_window : KeyboardWindow
    - user : str
    - model_name : str
    - model_path : str
    --
    + __init__(self, predict_controller=None, save_capture_controller=None, keyboard_window=None)
